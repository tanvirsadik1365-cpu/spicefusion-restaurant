NEXT_PUBLIC_SITE_URL=https://spicefusiontakeaway.co.uk
NEXT_PUBLIC_GTM_ID=GTM-546CFWHS
# Shared Supabase project values (same for all restaurant deployments)
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
# Tenant-specific identity. This must be unique per restaurant in the shared Supabase project.
RESTAURANT_ID=spicefusion-restaurant
RESTAURANT_TIME_ZONE=Europe/London
# Merchant token must be unique for the Spice Fusion merchant app.
MERCHANT_DASHBOARD_TOKEN=choose-a-private-merchant-dashboard-token
RESEND_API_KEY=
ORDER_EMAIL_FROM=Spice Fusion Takeaway <orders@spicefusiontakeaway.co.uk>
ORDER_EMAIL_REPLY_TO=contact@spicefusiontakeaway.co.uk
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here
# Optional: reuse a Stripe coupon instead of creating a one-time coupon per direct discount checkout.
STRIPE_DIRECT_DISCOUNT_COUPON_ID=
STRIPE_DELIVERY_COUPON_ID=
BANK_HOLIDAY_MONDAYS=
